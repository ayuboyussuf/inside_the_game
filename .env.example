# Azure OpenAI (hackathon hero tech). Leave empty to run fully offline on templates.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Omit the key to authenticate with Entra ID / managed identity (pip install ".[azure]")
AZURE_OPENAI_API_KEY=
# Point tracking (optional, GPU): path to the BootsTAPIR PyTorch checkpoint
TAPNET_CHECKPOINT=checkpoints/bootstapir_checkpoint_v2.pt
